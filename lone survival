	local function gimove()
		local fov = camera.FieldOfView
		local viewportSize = camera.ViewportSize

		local halfFovRad = math.rad(fov / 2)
		local visibleHeight = 2 * DISTANCE * math.tan(halfFovRad)
		local aspectRatio = viewportSize.X / viewportSize.Y
		local visibleWidth = visibleHeight * aspectRatio

		part.Size = Vector3.new(visibleWidth, visibleHeight, 0.1)
		part.CFrame = camera.CFrame * CFrame.new(0, 0, -DISTANCE)
	end
	camera.Changed:Connect(function()
		screenGui.CanvasSize = Vector2.new(camera.ViewportSize.X,camera.ViewportSize.Y)
	end)
	-- Update the part every frame to perfectly cover the screen
	RunService.RenderStepped:Connect(function()
		gimove()
	end)
