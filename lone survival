scrollingFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = scrollingFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)
UserInputService.InputChanged:Connect(function(input,processed)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		local xtogetoffset = camera.ViewportSize.X*startPos.X.Scale
		local ytogetoffset = camera.ViewportSize.Y*startPos.Y.Scale
		scrollingFrame.Position = UDim2.new(
			0,
			startPos.X.Offset + delta.X+xtogetoffset,
			0,
			startPos.Y.Offset + delta.Y+ytogetoffset
		)
	end
end)
